# Normalize all text files to LF in the repository.
# Without this, Windows clones (core.autocrlf=true) check out shell scripts
# with CRLF endings, which breaks their shebang inside Linux containers.
* text=auto eol=lf

# Shell scripts are copied into Docker images and executed there: always LF.
*.sh text eol=lf

# Binary files must never be touched.
*.war binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.p12 binary
*.jks binary
*.keystore binary
*.truststore binary
*.crt binary
*.key binary
